{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume",
        "hooks": [
          {
            "type": "command",
            "command": "${user_config.python}",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/skills/whalory/scripts/hub_client.py",
              "tick",
              "--quiet",
              "--host",
              "claude-code"
            ],
            "async": true,
            "timeout": 30
          }
        ]
      }
    ]
  }
}
